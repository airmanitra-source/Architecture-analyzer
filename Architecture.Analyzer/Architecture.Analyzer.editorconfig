[*.cs]


architecture_analyzer.model_suffix = BusinessModel
architecture_analyzer.model_folder = Models/Business

# Pour plusieurs conventions, cette option remplace les deux options ci-dessus.
# Exemple : BusinessModel=Models/Business;DataModel=Models/Data
architecture_analyzer.model_conventions = BusinessModel=Models/Business;DataModel=Models/Data

# Règles d'exclusion par dossier : dossier=SuffixeAutorisé1,SuffixeAutorisé2
# Exemple : Models/Business=BusinessModel;Models/Data=DataModel
architecture_analyzer.model_folder_allowed_suffixes = Models/Business=BusinessModel;Models/Data=DataModel

# Liste blanche de fichiers par projet — ARCH003 (mode strict).
# Dans un projet dont le nom d'assembly correspond au motif, tout fichier .cs dont le NOM ne
# correspond a aucun des motifs permis est interdit. Motifs facon ARCH016 : *X suffixe, X* prefixe,
# X exact, *X* contient. Cle projet et motifs separes par ',' ou '|', regles par ';'. Desactivee si absente.
# architecture_analyzer.project_allowed_files = *.Contracts=*Dto.cs,*Request.cs,*Response.cs;*.Handlers=*Handler.cs

# Longueur minimale du nom d'une variable (variables locales et champs) — ARCH013.
# Règle désactivée si la clé est absente. Décommentez pour l'activer.
# architecture_analyzer.min_variable_name_length = 3

# Longueur minimale du nom d'une classe — ARCH014.
# Règle désactivée si la clé est absente. Décommentez pour l'activer.
# architecture_analyzer.min_class_name_length = 3

# Longueur minimale du nom d'une méthode — ARCH015.
# Règle désactivée si la clé est absente. Décommentez pour l'activer.
# architecture_analyzer.min_method_name_length = 3

# Types de paramètres interdits selon le nom de la classe — ARCH016.
# Syntaxe « MotifClasse>MotifTypeInterdit » : les méthodes d'une classe dont le nom
# correspond à MotifClasse ne peuvent pas avoir de paramètre dont le type correspond
# à MotifTypeInterdit. Le caractère '*' choisit le mode de correspondance :
#   *Module   -> se termine par (suffixe)
#   Module*   -> commence par (préfixe)
#   Module    -> nom entier (exact)
#   *Module*  -> contient
# Plusieurs règles séparées par ';' (ou ','). Désactivée si la clé est absente.
# architecture_analyzer.method_argument_type_barrier = *Module>*DataModel

# Duplication structurelle de methodes — ARCH019.
# Compare la FORME du corps des methodes (suite de types de jetons, identifiants et
# litteraux ignores) : un copier-coller-renommer est donc detecte.
#   duplicate_code_min_tokens          : taille minimale d'un corps pris en compte (defaut 30)
#   duplicate_code_similarity_percent  : seuil de similarite, 100 = forme identique (defaut 90)
# architecture_analyzer.duplicate_code_min_tokens = 30
# architecture_analyzer.duplicate_code_similarity_percent = 90

# Ratio tests / code de production par prompt — ARCH021.
# Mesure a l'echelle de la SOLUTION (les tests vivent dans un autre projet).
# Regle desactivee si min_test_lines_percent est absent.
# architecture_analyzer.min_test_lines_percent = 20
# architecture_analyzer.test_ratio_min_added_lines = 50
# architecture_analyzer.test_file_patterns = /tests/;.tests/;tests.cs;test.cs;spec.cs

# Lien de test : un membre ajoute doit etre exerce par un test ajoute — ARCH025.
# La ou ARCH021 mesure un VOLUME de lignes de test, ARCH025 exige que le test PORTE sur le
# code change : une methode/un constructeur non prive, nouveau ou ayant grossi d'au moins le
# plancher, doit etre appele par un test ajoute ou modifie dans le meme changement, avec une
# assertion, dans un fichier qui reference le type concret (mocker l'interface ne compte pas).
# Ne regarde que ce que le changement rend nouveau : aucun backlog sur du code existant.
#   test_link_min_added_lines : active la regle et fixe le plancher (0 = off, suggere 3)
#   test_link_exclude_paths   : fragments de chemin jamais responsables (migrations, controllers...)
#   test_attribute_names      : attributs reconnus comme test (defaut Fact;Theory;Test;TestMethod...)
#   test_assertion_patterns   : prefixes d'assertion (defaut Assert;Should;Verify;Received...)
# Reutilise test_file_patterns d'ARCH021 pour classer les fichiers de test.
# architecture_analyzer.test_link_min_added_lines = 3
# architecture_analyzer.test_link_exclude_paths = /Migrations/;/Controllers/;Program.cs
# architecture_analyzer.test_attribute_names = Fact;Theory;Test;TestCase;TestCaseSource;TestMethod;DataTestMethod
# architecture_analyzer.test_assertion_patterns = Assert;Should;Verify;Received;DidNotReceive;Expect;Throws

# Oscillation : ce changement reintroduit du code recemment supprime — ARCH027.
# Signale, de facon FACTUELLE (avertissement, aucun jugement revert/thrashing), quand ce
# changement re-ajoute un bloc de >= 3 lignes qu'un des N derniers commits avait supprime.
# Inter-commits par nature : impossible pour un analyseur sans etat. Desactivee si la cle est absente.
#   oscillation_window_commits : nombre de commits recents examines (0 = off, suggere 5)
# architecture_analyzer.oscillation_window_commits = 5

# Nom de type deja pris par un projet reference — ARCH020.
# Portee par defaut : le premier segment du nom de l'assembly compile
# (CyberPointNet.Portal ne se compare qu'aux CyberPointNet.*), jamais au framework.
# architecture_analyzer.duplicate_type_name_scope = CyberPointNet
# architecture_analyzer.duplicate_type_name_exceptions = Program;Startup

# Cliquet de complexite cyclomatique — ARCH022.
# La complexite d'une methode peut rester egale ou baisser, jamais augmenter.
# Aucun seuil arbitraire, aucun fichier de baseline : seul ce que le changement
# courant degrade est signale. Activee par defaut.
# architecture_analyzer.complexity_ratchet_allowed_increase = 0

# Points chauds — ARCH023 (cliquet en mode strict).
# Le churn ne mesure rien : il selectionne les fichiers ou le cliquet passe en erreur.
# Il ne peut que croitre, il ne serait donc pas ratchetable lui-meme.
# architecture_analyzer.hotspot_churn_percentile = 90
# architecture_analyzer.churn_window_days = 90

# Conventions inferees du code — ARCH024.
# Apprend les regularites du projet (dossier, nature, sealed, type de base... par suffixe)
# et signale, dans les fichiers modifies uniquement, les types qui s'en ecartent.
# Additive a ARCH001/003 : un suffixe configure la-bas garde sa regle explicite.
# architecture_analyzer.convention_min_support = 5
# architecture_analyzer.convention_min_ratio = 90
# architecture_analyzer.convention_ignore = Provider>folder

# Historique d'impact (CSV) — 1A.
# Ecrit une ligne dans .architecture/impact-history.csv a la racine du depot a chaque
# changement significatif, avec le PROMPT qui l'a cause (fichier .architecture/current-prompt.txt
# depose par un hook de l'outil d'IA, ou variable d'environnement ARCHITECTURE_ANALYZER_PROMPT).
# Une seule ligne par prompt : les nombreux builds d'un meme prompt sont dedupliques.
# OPT-IN : desactive par defaut, car il ecrit des fichiers dans le depot du consommateur.
# Pense a ajouter .architecture/ a ton .gitignore.
# architecture_analyzer.impact_history_enabled = true
