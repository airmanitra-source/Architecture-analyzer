<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <PackageId>Herimanitra.Architecture.Analyzer</PackageId>
    <Version>1.0.0</Version>
    <Authors>Herimanitra</Authors>
    <Description>Roslyn analyzers for enforcing architecture and naming conventions in .NET solutions.</Description>
    <PackageTags>roslyn;analyzer;architecture;dotnet</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/airmanitra-source/Architecture-analyzer</RepositoryUrl>
    <PackageProjectUrl>https://github.com/airmanitra-source/Architecture-analyzer</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="LICENSE.txt" Pack="true" PackagePath="" Visible="false" />
    <None Include="Architecture.Analyzer.editorconfig" Pack="true" PackagePath="contentFiles\any\any\.editorconfig" Link=".editorconfig" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The analyzer assembly itself. -->
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />

    <!-- MSBuild targets that compute the LOC budget inputs from the git CLI at build time.
         Shipped in both build/ and buildTransitive/ so the target runs in consuming projects. -->
    <None Include="build\Architecture.Analyzer.targets" Pack="true" PackagePath="build\Architecture.Analyzer.targets" Visible="false" />
    <None Include="build\Architecture.Analyzer.targets" Pack="true" PackagePath="buildTransitive\Architecture.Analyzer.targets" Visible="false" />
  </ItemGroup>
</Project>
