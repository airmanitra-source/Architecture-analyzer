<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <PackageId>Architecture.Analyzer</PackageId>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="LibGit2Sharp.NativeBinaries" Version="2.0.323" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Architecture.Analyzer.editorconfig" Pack="true" PackagePath="contentFiles\any\any\.editorconfig" Link=".editorconfig" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The analyzer assembly itself. -->
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />

    <!-- LibGit2Sharp must ship next to the analyzer so Roslyn's assembly loader can resolve it;
         its native binaries must sit under runtimes/<rid>/native relative to the managed DLL. -->
    <None Include="$(PkgLibGit2Sharp)\lib\net8.0\LibGit2Sharp.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(PkgLibGit2Sharp_NativeBinaries)\runtimes\**\*.*" Pack="true" PackagePath="analyzers/dotnet/cs/runtimes" Visible="false" />
  </ItemGroup>
</Project>
