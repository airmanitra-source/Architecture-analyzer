<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Computes the "lines of code added since HEAD" budget inputs using the git CLI (no LibGit2Sharp).
    The numbers are handed to the analyzer through CompilerVisibleProperty, so the analyzer itself
    stays a pure function of the compilation + options and performs no IO.
  -->

  <ItemGroup>
    <CompilerVisibleProperty Include="ArchitectureLocProjectAddedLines" />
    <CompilerVisibleProperty Include="ArchitectureLocProjectBaselineLines" />
    <CompilerVisibleProperty Include="ArchitectureLocSolutionAddedLines" />
    <CompilerVisibleProperty Include="ArchitectureLocSolutionBaselineLines" />
    <CompilerVisibleProperty Include="ArchitectureLocAddedProductionLines" />
    <CompilerVisibleProperty Include="ArchitectureLocAddedTestLines" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ArchitectureBaselineFor" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ArchitectureChurnTable" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ArchitectureChangedFiles" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ArchitectureChangedTestFile" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ArchitectureOscillationRemoved" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ArchitectureOscillationAdded" />
    <!-- So ARCH003's per-project file allow-list can match a path relative to the project root
         (folder-bearing patterns like Models/*BusinessModel.cs), not just the file name. -->
    <CompilerVisibleProperty Include="ProjectDir" />
  </ItemGroup>

  <!-- The build-time task, compiled from real .cs files in Architecture.Analyzer.Build and packed
       under tasks/ in this package. This replaces the former inline RoslynCodeTaskFactory C#: no more
       CDATA escaping traps, and the task logic is unit-tested. It targets netstandard2.0 so it loads
       under both "dotnet build" and Visual Studio's MSBuild. -->
  <UsingTask
    TaskName="Architecture.Analyzer.Build.ComputeLocBudget"
    AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\Architecture.Analyzer.Build.dll" />

  <Target Name="_ComputeArchitectureLocBudget" BeforeTargets="GenerateMSBuildEditorConfigFileCore">
    <ComputeLocBudget
      WorkingDirectory="$(MSBuildProjectDirectory)"
      ProjectFiles="@(Compile->'%(FullPath)')"
      IsDesignTimeBuild="$(DesignTimeBuild)"
      BaselineDirectory="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)architecture-baseline">
      <Output TaskParameter="ProjectAddedLines" PropertyName="ArchitectureLocProjectAddedLines" />
      <Output TaskParameter="ProjectBaselineLines" PropertyName="ArchitectureLocProjectBaselineLines" />
      <Output TaskParameter="SolutionAddedLines" PropertyName="ArchitectureLocSolutionAddedLines" />
      <Output TaskParameter="SolutionBaselineLines" PropertyName="ArchitectureLocSolutionBaselineLines" />
      <Output TaskParameter="AddedProductionLines" PropertyName="ArchitectureLocAddedProductionLines" />
      <Output TaskParameter="AddedTestLines" PropertyName="ArchitectureLocAddedTestLines" />
      <Output TaskParameter="BaselineFiles" ItemName="_ArchitectureComplexityBaseline" />
      <Output TaskParameter="ChurnTable" ItemName="_ArchitectureChurnTable" />
      <Output TaskParameter="ChangedFiles" ItemName="_ArchitectureChangedFiles" />
      <Output TaskParameter="ChangedTestFiles" ItemName="_ArchitectureChangedTestFiles" />
      <Output TaskParameter="OscillationRemoved" ItemName="_ArchitectureOscillationRemoved" />
      <Output TaskParameter="OscillationAdded" ItemName="_ArchitectureOscillationAdded" />
    </ComputeLocBudget>

    <!-- Custom metadata carries over, so the analyzer can tell these apart from other AdditionalFiles. -->
    <ItemGroup>
      <AdditionalFiles Include="@(_ArchitectureComplexityBaseline)" />
      <AdditionalFiles Include="@(_ArchitectureChurnTable)" />
      <AdditionalFiles Include="@(_ArchitectureChangedFiles)" />
      <AdditionalFiles Include="@(_ArchitectureChangedTestFiles)" />
      <AdditionalFiles Include="@(_ArchitectureOscillationRemoved)" />
      <AdditionalFiles Include="@(_ArchitectureOscillationAdded)" />
    </ItemGroup>
  </Target>

</Project>
