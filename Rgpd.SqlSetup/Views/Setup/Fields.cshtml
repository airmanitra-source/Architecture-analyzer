@model IReadOnlyList<Rgpd.SqlSetup.ViewModels.SqlFieldViewModel>
@{
    ViewData["Title"] = "Champs personnels";
}

<h1>Champs personnels</h1>

<form asp-action="AddField" method="post" class="row g-2 mb-4">
    <div class="col-md-2"><input class="form-control" name="TableName" placeholder="Table" required /></div>
    <div class="col-md-2"><input class="form-control" name="ColumnName" placeholder="Colonne" required /></div>
    <div class="col-md-2"><input class="form-control" name="MaskFunction" placeholder="email()" value="default()" required /></div>
    <div class="col-md-2"><input class="form-control" name="Purpose" placeholder="Finalité" required /></div>
    <div class="col-md-2">
        <select class="form-select" name="LegalBasis" required>
            <option value="Consent" selected>Consentement</option>
            <option value="Contract">Contrat</option>
            <option value="LegalObligation">Obligation légale</option>
            <option value="VitalInterests">Intérêts vitaux</option>
            <option value="PublicTask">Mission d'intérêt public / autorité publique</option>
            <option value="LegitimateInterests">Intérêts légitimes</option>
        </select>
    </div>
    <div class="col-md-1"><input class="form-control" name="AllowedRoles" placeholder="Rôles" required /></div>
    <div class="col-md-1"><button class="btn btn-primary" type="submit">Ajouter / Mettre à jour</button></div>
</form>

<table class="table table-striped">
    <thead>
        <tr><th>Table</th><th>Colonne</th><th>Finalité</th><th>Base légale</th><th>Rôles</th></tr>
    </thead>
    <tbody>
    @foreach (var field in Model)
    {
        <tr>
            <td>@field.TableName</td>
            <td>@field.ColumnName</td>
            <td>@field.Purpose</td>
            <td>@field.LegalBasis</td>
            <td>@field.AllowedRoles</td>
        </tr>
    }
    </tbody>
</table>
