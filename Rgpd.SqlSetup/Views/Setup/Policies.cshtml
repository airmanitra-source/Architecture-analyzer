@model IReadOnlyList<Rgpd.SqlSetup.ViewModels.RlsPolicyViewModel>
@{
    ViewData["Title"] = "Politiques RLS";
}

<h1>Politiques RLS</h1>
<form asp-action="SyncPolicies" method="post" class="mb-3">
    <button class="btn btn-warning" type="submit">Synchroniser</button>
</form>

<table class="table table-striped">
    <thead>
        <tr><th>Policy</th><th>Fonction prédicat</th><th>Active</th></tr>
    </thead>
    <tbody>
    @foreach (var policy in Model)
    {
        <tr>
            <td>@policy.PolicyName</td>
            <td>@policy.PredicateFunctionName</td>
            <td>@policy.IsEnabled</td>
        </tr>
    }
    </tbody>
</table>
